{
  "name": "onlyhate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "web": "vite --host 0.0.0.0",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "8.4.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
